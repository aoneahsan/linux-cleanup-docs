# linux-cleanup-docs — environment contract
#
# 🔴 THIS REPO IS PUBLIC. Never commit a real value here.
#    Real values live in ~/.secrets/<service>/<name> and, for CI, in this
#    repository's GitHub Actions secrets (Settings → Secrets → Actions).
#
# Every key below is OPTIONAL. An unset key means that provider is skipped
# entirely — the docs build must never require a secret to succeed.

# [OPTIONAL] Google Analytics 4 measurement ID. Unset = no analytics script.
GA_MEASUREMENT_ID=

# [OPTIONAL] Microsoft Clarity project ID. Unset = no session replay.
CLARITY_PROJECT_ID=

# [OPTIONAL] Amplitude API key. Unset = no product analytics.
AMPLITUDE_API_KEY=

# [OPTIONAL] Sentry DSN for build/runtime error reporting. Unset = no Sentry.
SENTRY_DSN=
