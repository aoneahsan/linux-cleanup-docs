# linux-cleanup-docs — environment contract
#
# 🔴 THIS REPO IS PUBLIC. Never commit a real value here.
#    Real values live in ~/.secrets/<service>/<name>; a local .env (git-ignored) holds the client-safe ones for the
#    build. There is no CI: the site is built and published by hand.
#
# Every key below is OPTIONAL. An unset key means that provider is skipped
# entirely — the docs build must never require a secret to succeed.

# [OPTIONAL] Google Analytics 4 measurement ID. Unset = no analytics script.
GA_MEASUREMENT_ID=

# [OPTIONAL] Microsoft Clarity project ID. Unset = no session replay.
CLARITY_PROJECT_ID=

# [OPTIONAL] Amplitude API key. Unset = no product analytics.
AMPLITUDE_API_KEY=

# [OPTIONAL] Sentry DSN for build/runtime error reporting. Unset = no Sentry.
SENTRY_DSN=

# [OPTIONAL] The release record for update flow layer 2 (client-safe Supabase URL and publishable key).
# Unset = no release gate; the deploy check refuses a build without it.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# [OPTIONAL] `test` makes a build read the test channel (for proving the gate). Unset = production.
RELEASE_CHANNEL=
